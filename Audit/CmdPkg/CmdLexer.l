[ \t]					;

(\/{2,2}.*)				;

[,=:]					{ return yytext[0]; }

[-0-9]+					{ yylval.m_int = atoi(yytext); return INT; }


([-0-9]*\.[0-9]+[eE][-+]?[0-9]+)    { yylval.m_real = atof(yytext); return REAL; }
([-0-9]+\.[eE][-+]?[0-9]+)          { yylval.m_real = atof(yytext); return REAL; }
([-0-9]*\.[0-9]+)                  { yylval.m_real = atof(yytext); return REAL; }
([-0-9]+\.)                        { yylval.m_real = atof(yytext); return REAL; }

["]			{ 
				strcpy( yylval.m_string, string_get('"') );
				return STRING;
			}

\'[^']*[']				{ 
							if (strlen(yytext) < 3)
							{
								yylval.m_string[0] = '\0';
							}
							else
							{
								yytext[ strlen(yytext)-1 ] = 0;
								strcpy( yylval.m_string, (yytext+1) );
							}
							return STRING;
						}
						
[a-z$#@A-Z_][a-zA-Z0-9_]*	{ 
							strcpy( yylval.m_string, yytext );
							return IDENTIFIER;
						}

