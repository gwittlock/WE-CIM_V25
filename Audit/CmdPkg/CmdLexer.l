#define BUFFER_MAX 1024
static char buffer[BUFFER_MAX];  // must match definition of m_string in CmdParser.y
static const char* string_get( char terminal_char );

// Otherwise the lexer is file-based.
#define YY_ALWAYS_INTERACTIVE 1

//=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=
// Do the usual stuff to avoid the lex-generated input()
//=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=

#define EOS '\0'

extern char cmd_getc();


// The following macro is defined to obtain one character of input.
// The lexer generates it's own similar macro but we define this one
// as an override since we are using a char sting as the input.
// The function jos_getc() acts as the interface.
#define YY_INPUT(buf,result,max_size) \
{ \
	int c = cmd_getc(); \
	if ( c == EOF || c == EOS ) \
	{ \
		buf[0] = EOS; \
		result = 0; \
	} \
	else \
	{ \
		buf[0] = (char) c; \
		result = 1; \
	} \
}


