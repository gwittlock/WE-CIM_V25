// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDR_MAINFRAME           ICON    DISCARDABLE     "res\\FilePeek.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOG DISCARDABLE  0, 0, 235, 55
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About FilePeek"
FONT 8, "MS Sans Serif"
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,11,17,20,20
    LTEXT           "FilePeek Version 1.0",IDC_STATIC,40,10,119,8,
                    SS_NOPREFIX
    LTEXT           "Copyright (C) 2002",IDC_STATIC,40,25,119,8
    DEFPUSHBUTTON   "OK",IDOK,178,7,50,14,WS_GROUP
END

IDD_FILEPEEK_DIALOG DIALOGEX 0, 0, 394, 269
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "FilePeek"
FONT 8, "Courier New"
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,337,229,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,337,246,50,14
    EDITTEXT        IDC_BYTES,56,58,40,14
    EDITTEXT        IDC_BITS,140,58,40,14
    EDITTEXT        IDC_SHORT,127,213,40,14,ES_AUTOHSCROLL | ES_READONLY
    EDITTEXT        IDC_INTEGER,127,232,40,14,ES_AUTOHSCROLL | ES_READONLY
    EDITTEXT        IDC_LONG,211,213,40,14,ES_AUTOHSCROLL | ES_READONLY
    EDITTEXT        IDC_HANDLE,211,232,40,14,ES_AUTOHSCROLL | ES_READONLY
    LTEXT           "Bytes",IDC_STATIC,31,61,23,8
    LTEXT           "Bits",IDC_STATIC,120,61,17,8
    LTEXT           "short",IDC_STATIC,101,216,22,8
    LTEXT           "integer",IDC_STATIC,95,235,29,8
    LTEXT           "long",IDC_STATIC,187,216,21,8
    LTEXT           "handle",IDC_STATIC,180,235,28,8
    GROUPBOX        "Offset",IDC_STATIC,18,44,179,37
    GROUPBOX        "Data",IDC_STATIC,15,198,292,60
    EDITTEXT        IDC_DATA,50,88,331,105,ES_MULTILINE | ES_NOHIDESEL | 
                    ES_READONLY | ES_WANTRETURN
    EDITTEXT        IDC_PATH,14,11,234,14,ES_AUTOHSCROLL
    PUSHBUTTON      "Browse",IDC_BROWSE,256,11,50,14
    CONTROL         "Spin1",IDC_BYTE_SPINNER,"msctls_updown32",UDS_ARROWKEYS,
                    97,58,9,14
