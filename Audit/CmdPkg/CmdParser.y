// The lexer (of course).
extern int yylex();

// See also notes at yyForceRestart().
extern void yyForceRestart();

// The current token from yylex(). For use by yyerror().
extern char* yytext;

// A forward reference (compiler fodder)
int yyparse();

// So that yyerror() can echo the input.
const char*	m_input_string;

// m_cmd_string is the text we are parsing.
char*		m_cmd_string;

// The application's recipient command structure.
CCommand*	m_cmd;

// Transient var for compilation purposes.
CVar*		m_var;

%}

%union
{
	void*	m_void;
	int		m_int;
	double	m_real;
//	char	m_string[256];  // used char[] to avoid memory management issues!
	char	m_string[1024];  // used char[] to avoid memory management issues!
}

%token <m_string>	IDENTIFIER
%token <m_string>	STRING
%token <m_int>		INT
%token <m_real>		REAL

%type <m_string>	text

