#include "stdafx.h"
#include <math.h>
#include "MathConst.h"
#include "cmn_resource.h"
#include "Return.h"

// The lexer (of course).
extern int yylex();

// See also notes at yyForceRestart().
extern void yyForceRestart();

// A forward reference (compiler fodder)
int yyparse();

// m_expression is the text we are parsing.
char*	m_expression;
double	m_value;
%}

%union
{
	int		m_int;
	double	m_real;
}

%token <m_int>		DECINT
%token <m_int>		HEXINT
%token <m_real>		REAL

%type <m_real>		expression
%type <m_real>		number
%type <m_int>		integer

%left OP_EQ, OP_LE, OP_GE, OP_LT, OP_GT, OP_NE
%left OP_AND, OP_OR, OP_XOR, OP_MIN, OP_MAX
%nonassoc OP_LSHIFT, OP_RSHIFT
%left '+', '-'
%left '*', '/', '%'
%left '&', '|', '^'
%right OP_SIN, OP_COS, OP_TAN, OP_ASIN, OP_ACOS, OP_ATAN, OP_RAD, OP_DEG
%right OP_NOT
%right UMINUS

%%

// ============================================================================
//	main
//
main:
	expression							{ m_value = $1; }
	;

// ============================================================================
//		expression:  Mathematical expressions
//
//
expression:
	expression '+' expression			{ $$ = $1 + $3; }
	| expression '-' expression			{ $$ = $1 - $3; }
	| expression '*' expression			{ $$ = $1 * $3; }
	| expression '/' expression			{ 
											if ($3 != 0.0)
												$$ = $1 / $3;
											else
												$$ = 0.0;
										}
	| expression '%' expression			{ $$ = (double)( (int)$1 % (int)$3 ); }
	| expression '&' expression			{ $$ = (double)( (int)$1 & (int)$3 ); }
	| expression '|' expression			{ $$ = (double)( (int)$1 | (int)$3 ); }
	| expression '^' expression			{ $$ = (double)( (int)$1 ^ (int)$3 ); }
	| expression OP_AND expression		{ $$ = ONE($1) && ONE($3); }
	| expression OP_OR expression		{ $$ = ONE($1) || ONE($3); }
	| expression OP_XOR expression		{ $$ = (ONE($1) || ONE($3)) && (ZERO($1) || ZERO($3)); }
	| expression OP_MIN expression		{ $$ = min( $1, $3 ); }
	| expression OP_MAX expression		{ $$ = max( $1, $3 ); }
	| expression OP_EQ expression		{ $$ = EQUAL( $1, $3 ); }
	| expression OP_LE expression		{ $$ = $1 <= $3; }
	| expression OP_GE expression		{ $$ = $1 >= $3; }
	| expression OP_LT expression		{ $$ = $1 < $3; }
	| expression OP_GT expression		{ $$ = $1 > $3; }
	| expression OP_NE expression		{ $$ = !EQUAL($1, $3); }
	| expression OP_LSHIFT expression	{ $$ = (int)$1 << (int)$3; }
	| expression OP_RSHIFT expression	{ $$ = (int)$1 >> (int)$3; }

	| OP_ASIN '(' expression ')'		{ $$ = RAD2DEG * asin( $3 ); }
	| OP_ACOS '(' expression ')'		{ $$ = RAD2DEG * acos( $3 ); }
	| OP_ATAN '(' expression ')'		{ $$ = RAD2DEG * atan( $3 ); }
	| OP_SIN '(' expression ')'			{ $$ = sin( DEG2RAD * $3 ); }
	| OP_COS '(' expression ')'			{ $$ = cos( DEG2RAD * $3 ); }
	| OP_TAN '(' expression ')'			{ $$ = tan( DEG2RAD * $3 ); }
	| OP_DEG '(' expression ')'			{ $$ = $3 * RAD2DEG; }
	| OP_RAD '(' expression ')'			{ $$ = $3 * DEG2RAD; }


	| '(' expression ')'				{ $$ = $2; }
	| '-' expression %prec UMINUS		{ $$ = -$2; }
	| '~' expression %prec UMINUS		{ $$ = ~(int)$2; }
	| OP_NOT expression %prec UMINUS	{ $$ = ZERO( $2 ); }
	| number							{ $$ = $1; }
	;


number:
	integer						{ $$ = (double)$1; }
	| REAL						{ $$ = $1; }
	;

integer:
	DECINT						{ $$ = (int)$1; }
	| HEXINT					{ $$ = (int)$1; }
	;

%%

// ============================================================================

int ExpParse( const char* expression )
{
	int	status;

	m_value = UNDEFINED;

	m_expression = (char*) expression;

	status = yyparse();

	return status;
}

double ExpParseValueGet()
{
	return m_value;
}

void yyerror( const char* in_error )
{
	CReturn	status;

	// TODO:  Replace with *real* error handling
	//   MessageBox( NULL, in_error, NULL, MB_OK );
	status.Internal( IDS_INTERNAL_ERROR, in_error );

	yyForceRestart();
}

