%%

"=="		{ return OP_EQ; }
"<>"		{ return OP_NE; }
"<="		{ return OP_LE; }
"<"			{ return OP_LT; }
">="		{ return OP_GE; }
">"			{ return OP_GT; }

"<<"		{ return OP_LSHIFT; }
">>"		{ return OP_RSHIFT; }

and			{ return OP_AND; }
not			{ return OP_NOT; }
or			{ return OP_OR; }
xor			{ return OP_XOR; }

min			{ return OP_MIN; }
max			{ return OP_MAX; }

asin		{ return OP_ASIN; }
acos		{ return OP_ACOS; }
atan		{ return OP_ATAN; }
sin			{ return OP_SIN; }
cos			{ return OP_COS; }
tan			{ return OP_TAN; }

rad			{ return OP_RAD; }
deg			{ return OP_DEG; }

[ \t]					;

[\$\#\~\&\|\?\^@;:(){}\[\]=+\-\*/\%]	{ return yytext[0]; }

[0-9]+					{ yylval.m_int = atoi(yytext); return DECINT; }

"0x"[0-9a-fA-F]{2,4}	{ sscanf( yytext, "%x", &yylval.m_int ); return HEXINT; }

([0-9]*\.[0-9]+[eE][-+]?[0-9]+)    { yylval.m_real = (float)atof(yytext); return REAL; }
([0-9]+\.[eE][-+]?[0-9]+)          { yylval.m_real = (float)atof(yytext); return REAL; }
([0-9]*\.[0-9]+)                   { yylval.m_real = (float)atof(yytext); return REAL; }
([0-9]+\.)						   { yylval.m_real = (float)atof(yytext); return REAL; }

