/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_VIEW_OPTIONS DIALOG DISCARDABLE  0, 0, 254, 137
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "View Options"
FONT 8, "MS Sans Serif"
BEGIN
    CONTROL         "Show Profile Markers",IDC_VIEW_PROFMARKER,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,5,5,79,10
    CONTROL         "Show Toolpath Geometry Dashed",IDC_VIEW_TOOLDASH,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,5,20,118,10
    CONTROL         "Show Text Commands",IDC_VIEW_TEXT,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,5,35,83,10
    CONTROL         "Show Nibble Hits",IDC_VIEW_NIBBLE,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,5,50,67,10
    CONTROL         "Show Stock Layer",IDC_VIEW_STOCK,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,5,65,70,10
    LTEXT           "Snap Grid Resolution",IDC_STATIC,5,83,65,8
    EDITTEXT        IDC_GRID,73,80,40,14,ES_AUTOHSCROLL | ES_NUMBER
    CONTROL         "GDI Mode",IDC_GDI,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,
                    140,15,47,10
    DEFPUSHBUTTON   "OK",IDOK,200,120,50,14
    PUSHBUTTON      "Cancel",ID_CANCEL,200,100,50,14
    GROUPBOX        "Advanced Options",IDC_STATIC,135,5,110,90
    CONTROL         "White Background",IDC_WHITE,"Button",BS_AUTOCHECKBOX | 
                    WS_TABSTOP,140,30,71,10
    CONTROL         "Monochrome",IDC_MONO,"Button",BS_AUTOCHECKBOX | 
                    WS_TABSTOP,140,45,56,10
    EDITTEXT        IDC_PROFSCALE,200,57,40,14,ES_AUTOHSCROLL | ES_NUMBER
    EDITTEXT        IDC_PICKTOL,200,75,40,14,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Profile Marker Size",IDC_STATIC,140,60,57,8
    LTEXT           "Pick Tolerance",IDC_STATIC,150,78,47,8
END


