/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDR_MAINFRAME           ICON    DISCARDABLE     ".\\res\\RcvrApp.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOG DISCARDABLE  0, 0, 132, 90
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION
CAPTION "About RcvrApp"
FONT 8, "MS Sans Serif"
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,12,20,21,20
    LTEXT           "RcvrApp Version 1.0",IDC_STATIC,48,12,72,8,SS_NOPREFIX
    LTEXT           "Copyright (C) 2001",IDC_STATIC,48,28,64,8
    DEFPUSHBUTTON   "OK",IDOK,45,64,40,16,WS_GROUP
    LTEXT           "Building Blocks Inc.",IDC_STATIC,48,44,52,8
END

IDD_RECV_DLG DIALOGEX 0, 0, 369, 210
STYLE DS_SETFOREGROUND | DS_3DLOOK | WS_MINIMIZEBOX | WS_POPUP | WS_CAPTION | 
    WS_SYSMENU | WS_THICKFRAME
EXSTYLE WS_EX_CLIENTEDGE
CAPTION "Diagnostic Messages"
FONT 8, "Courier New"
BEGIN
    LISTBOX         IDC_LIST1,5,5,355,198,LBS_NOINTEGRALHEIGHT | 
                    LBS_EXTENDEDSEL | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP
END

IDD_DIALOG1 DIALOG DISCARDABLE  0, 0, 157, 46
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 8, "MS Sans Serif"
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,44,24,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,98,24,50,14
    LTEXT           "Max Number of Messages",IDC_STATIC,10,8,83,8
    EDITTEXT        IDC_EDIT1,98,5,50,14,ES_AUTOHSCROLL
END


