/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOG DISCARDABLE  0, 0, 235, 55
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About AutoPunchTest"
FONT 8, "MS Sans Serif"
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,11,17,20,20
    LTEXT           "AutoPunchTest Version 1.0",IDC_STATIC,40,10,119,8,
                    SS_NOPREFIX
    LTEXT           "Copyright (C) 2002",IDC_STATIC,40,25,119,8
    DEFPUSHBUTTON   "OK",IDOK,178,7,50,14,WS_GROUP
END

IDD_AUTOPUNCHTEST_DIALOG DIALOGEX 0, 0, 320, 170
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "AutoPunchTest"
FONT 8, "MS Sans Serif"
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,208,149,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,263,149,50,14
    COMBOBOX        IDC_MACHINE_COMBO,54,30,107,52,CBS_DROPDOWN | WS_VSCROLL | 
                    WS_TABSTOP
    LTEXT           "Machine",IDC_STATIC,22,32,28,8
    COMBOBOX        IDC_TOOL_SETUP_COMBO,54,46,107,49,CBS_DROPDOWN | 
                    WS_VSCROLL | WS_TABSTOP
    LTEXT           "Tool Setup",IDC_STATIC,14,48,36,8
    EDITTEXT        IDC_PTOL,208,52,40,14,ES_AUTOHSCROLL
    EDITTEXT        IDC_MTOL,208,70,40,14,ES_AUTOHSCROLL
    LTEXT           "+Tol",IDC_STATIC,188,54,15,8
    LTEXT           "-Tol",IDC_STATIC,190,73,13,8
    EDITTEXT        IDC_PATH,53,97,178,14,ES_AUTOHSCROLL
    PUSHBUTTON      "Browse",IDC_BROWSE,237,98,50,14
    CONTROL         "Dir",IDC_FOLDER,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,
                    24,99,25,10
    CONTROL         "Build Tool Setup",IDC_BUILD,"Button",BS_AUTOCHECKBOX | 
                    WS_TABSTOP,184,38,68,10
    EDITTEXT        IDC_CMDB_PATH,54,12,178,14,ES_AUTOHSCROLL
    LTEXT           "CMDB",IDC_STATIC,28,16,22,8
    PUSHBUTTON      "Browse",IDC_CMDB_BROWSE,237,13,50,14
    COMBOBOX        IDC_LAYER_SETUP_COMBO,54,63,107,49,CBS_DROPDOWN | 
                    WS_VSCROLL | WS_TABSTOP
    COMBOBOX        IDC_MATERIAL_COMBO,54,79,107,49,CBS_DROPDOWN | 
                    WS_VSCROLL | WS_TABSTOP
    LTEXT           "Layer Setup",IDC_STATIC,11,65,39,8
    LTEXT           "Material",IDC_STATIC,24,81,26,8
    EDITTEXT        IDC_MM2_PATH,53,115,178,14,ES_AUTOHSCROLL
    PUSHBUTTON      "Browse",IDC_MM2_BROWSE,237,115,50,14
    LTEXT           "Result",IDC_STATIC,27,118,21,8
END


