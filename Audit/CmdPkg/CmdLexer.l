static const char* string_get( char terminal_char )
{
	char c;
	int nchars = 0;

	while (c = yyinput())
	{
		if (nchars >= (BUFFER_MAX-1))
			break;

		if (c == terminal_char)
			break;
/*
		if (c == '\\')  // the escape-character
		{
			char next_c = yyinput();
			switch (next_c)
			{
			case 'n':  c = '\n';  break;
			case 't':  c = '\t';  break;
			case '\\': c = '\\';  break;
			case '"':  c = '"';   break;
			default:   c = next_c;  break;
			}
		}
*/
		buffer[nchars] = c;
		++nchars;
	}

	buffer[nchars] = '\0';

	return buffer;
}

