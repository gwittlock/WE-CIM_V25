// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDR_MAINFRAME           ICON    DISCARDABLE     "res\\SmartCamConvertor.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOG DISCARDABLE  0, 0, 235, 55
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About SmartCamConvertor"
FONT 8, "MS Sans Serif"
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,11,17,20,20
    LTEXT           "SmartCamConvertor Version 1.0",IDC_STATIC,40,10,119,8,
                    SS_NOPREFIX
    LTEXT           "Copyright (C) 2002",IDC_STATIC,40,25,119,8
    DEFPUSHBUTTON   "OK",IDOK,178,7,50,14,WS_GROUP
END

IDD_SMARTCAMCONVERTOR_DIALOG DIALOGEX 0, 0, 307, 210
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "PM4/JOF Convertor"
FONT 8, "MS Sans Serif"
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,187,185,50,14
    PUSHBUTTON      "Done",IDCANCEL,242,185,50,14
    EDITTEXT        IDC_JOF_PATH,59,133,178,14,ES_AUTOHSCROLL
    EDITTEXT        IDC_PM4_PATH,59,115,178,14,ES_AUTOHSCROLL
    LTEXT           "PM4 Path:",IDC_STATIC,20,118,35,8
    LTEXT           "JOF Path:",IDC_STATIC,22,137,33,8
    PUSHBUTTON      "Browse",IDC_PM4_BROWSE,242,115,50,14
    PUSHBUTTON      "Browse",IDC_JOF_BROWSE,242,132,50,14
    COMBOBOX        IDC_ACTION,59,9,106,56,CBS_DROPDOWN | WS_VSCROLL | 
                    WS_TABSTOP
    LTEXT           "Action:",IDC_STATIC,32,12,23,8
    COMBOBOX        IDC_MACHINE_COMBO,59,44,106,52,CBS_DROPDOWN | WS_VSCROLL | 
                    WS_TABSTOP
    LTEXT           "Machine",IDC_STATIC,27,46,28,8
    EDITTEXT        IDC_CMDB_PATH,59,26,178,14,ES_AUTOHSCROLL
    LTEXT           "CMDB",IDC_STATIC,33,30,22,8
    PUSHBUTTON      "Browse",IDC_CMDB_BROWSE,242,26,50,14
    COMBOBOX        IDC_MATERIAL_COMBO,59,78,106,49,CBS_DROPDOWN | 
                    WS_VSCROLL | WS_TABSTOP
    LTEXT           "Material",IDC_STATIC,29,80,26,8
    EDITTEXT        IDC_MM2_PATH,59,151,178,14,ES_AUTOHSCROLL
    PUSHBUTTON      "Browse",IDC_MM2_BROWSE,242,151,50,14
    LTEXT           "Result",IDC_STATIC,32,154,21,8
    CONTROL         "Common JOF",IDC_COMMON_JOF,"Button",BS_AUTOCHECKBOX | 
                    WS_TABSTOP,59,101,58,10
    COMBOBOX        IDC_TOOLSETUP_COMBO,59,61,106,52,CBS_DROPDOWN | 
                    WS_VSCROLL | WS_TABSTOP
    LTEXT           "Tool Setup",IDC_STATIC,20,63,36,8
    CONTROL         "Create Part Outline",IDC_PART_OUTLINE,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,59,171,75,10
END


